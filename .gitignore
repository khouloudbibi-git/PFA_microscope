# PFA_Microscope — STM32CubeIDE firmware (NUCLEO-F411RE)
# Rule: commit source + project config only. Never commit build output,
# machine-specific IDE state, debug probe configs, or credentials.

# ─── Secrets & credentials ─────────────────────────────────────────────
# Firmware has none today, but the Python <-> Firebase bridge does.
# If it is ever added to this repo, its keys must never be committed.
.env
.env.*
!.env.example
*credentials*.json
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
google-services.json
*secret*
*.pem
*.key
*.p12
*.pfx
*.crt
*.der
id_rsa*
id_ed25519*
*.ppk
.netrc

# ─── Build output (Debug/ Release/ folders created by CubeIDE) ─────────
/Debug/
/Release/
build/
*.o
*.d
*.su
*.cyclo
*.elf
*.bin
*.hex
*.srec
*.map
*.list
*.lst
*.a
*.axf
*.out

# ─── Machine-specific IDE / debugger state ─────────────────────────────
# Workspace metadata (absolute paths, Windows username)
.metadata/
RemoteSystemsTempFiles/
# Debug launch configs: absolute paths + ST-LINK probe serial number
*.launch
# Regenerated by CubeMX on every code generation, contains absolute paths
.mxproject
# Eclipse per-user preferences (language.settings.xml is kept: it is portable)
.settings/*
!.settings/language.settings.xml
# Other editors
.vscode/
.idea/
*.swp
*~

# ─── Python bridge artefacts (if added later) ──────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Private documents ─────────────────────────────────────────────────
# Report drafts, scans, datasheets with NDA, etc. stay off GitHub.
*.pdf
*.doc
*.docx
*.zip
*.rar
*.7z

# ─── Logs, temp, OS files ──────────────────────────────────────────────
*.log
*.tmp
*.bak
Thumbs.db
desktop.ini
.DS_Store
